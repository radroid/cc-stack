# ---------------------------------------------------------------------------
# Convex (database + backend)
# ---------------------------------------------------------------------------
# Created automatically by `bunx convex dev` on first run.
NEXT_PUBLIC_CONVEX_URL=

# ---------------------------------------------------------------------------
# Clerk (auth)
# ---------------------------------------------------------------------------
# From https://dashboard.clerk.com — API Keys page
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# JWT issuer domain — Clerk Dashboard → JWT Templates → create one named
# `convex` → copy the "Issuer" URL here AND set the same value with
# `bunx convex env set CLERK_JWT_ISSUER_DOMAIN <value>` so Convex can verify.
CLERK_JWT_ISSUER_DOMAIN=

# ---------------------------------------------------------------------------
# Web Push (VAPID)
# ---------------------------------------------------------------------------
# Generate with:  bunx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is read by the browser — safe to expose.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# VAPID_PRIVATE_KEY + VAPID_SUBJECT are used only by Convex actions to sign
# pushes. Set both via `bunx convex env set ...` for production. Documented
# here for local dev only.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# PostHog (analytics) — production-only
# ---------------------------------------------------------------------------
# Leave both UNSET in `.env.local` — PostHog will be a no-op in dev.
# Set them in `.env.production` and in your Cloudflare Worker secrets.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Set to "1" in a preview env if you want PostHog to fire there.
NEXT_PUBLIC_POSTHOG_FORCE_ENABLE=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used for absolute URLs in metadata / manifest / OG.
NEXT_PUBLIC_APP_URL=http://localhost:3000
