# Most users won't need to edit this file by hand — run `bun run setup` (dev)
# and `bun run setup:prod` (prod) instead. The CLI fills in everything below.
#
# This file is the canonical list of every variable the app reads.

# ---------------------------------------------------------------------------
# Convex (database + backend)
# ---------------------------------------------------------------------------
# `bunx convex dev` writes both of these on first run.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Production deploy key — generated in the Convex dashboard. Used by
# `bun run deploy` (and by the prod setup flow). Never commit.
CONVEX_DEPLOY_KEY=

# ---------------------------------------------------------------------------
# Clerk (auth)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# JWT issuer domain — `bun run setup` derives this from your secret key and
# mirrors it to Convex via `bunx convex env set CLERK_JWT_ISSUER_DOMAIN <value>`.
CLERK_JWT_ISSUER_DOMAIN=

# ---------------------------------------------------------------------------
# Web Push (VAPID)
# ---------------------------------------------------------------------------
# Public key is read by the browser to subscribe — safe to expose.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Private + subject are used only server-side (Convex actions) to sign pushes.
# `bun run setup` writes them to your Convex dev env automatically.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# PostHog (analytics)
# ---------------------------------------------------------------------------
# We use PostHog's Environments-within-a-Project: one project, separate write
# tokens per env. Same variable name; different value in .env.local /
# .env.production / Cloudflare secrets.
#
# In .env.local: leave UNSET unless you opted in to dev analytics during setup.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# `development` | `preview` | `production` — registered as a super-property on
# every event. Defaults to `development` (or `production` when NODE_ENV is).
NEXT_PUBLIC_POSTHOG_ENVIRONMENT=

# Set to "1" to bypass the prod-only init guard (e.g. on a preview deploy).
NEXT_PUBLIC_POSTHOG_FORCE_ENABLE=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public URL — used for absolute URLs in metadata, OG, manifest, and as the
# `deployment_url` super-property on PostHog events.
NEXT_PUBLIC_APP_URL=http://localhost:3000
